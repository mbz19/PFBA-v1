# Copy to .env for local development. Never commit .env.

# OAuth 2.0 Web client ID from Google Cloud Console (not a secret, but keep it out of the repo).
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Optional: ID of the spreadsheet the app uses as its database. If omitted, the
# app offers to create one (or paste an existing ID) on first sign-in.
VITE_SHEET_ID=

# Optional: base path the site is served from. GitHub Actions sets this to /<repo-name>/.
# BASE_PATH=/pfba/
